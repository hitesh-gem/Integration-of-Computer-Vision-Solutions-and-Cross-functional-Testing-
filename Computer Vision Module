
import cv2
import numpy as np

from fastapi import FastAPI, File, HTTPException, UploadFile
from pydantic import BaseModel, Field

app = FastAPI(
    title="CV Quality Control Integration Service",
    version="1.1.0",
)

MAX_FILE_SIZE = 10 * 1024 * 1024
MIN_CONTOUR_AREA = 500
ALLOWED_TYPES = {"image/jpeg", "image/png", "image/webp"}


class InspectionResult(BaseModel):
    status: str
    confidence: float | None = None
    defects_detected: int
    bounding_boxes: list[list[int]] = Field(
        default_factory=list,
        description="Each box is [x, y, width, height]",
    )
    message: str


def process_image_cv(image_bytes: bytes) -> dict:
    """Demonstration inspection using thresholding and contours.

    This is not a trained defect-detection model. Detected regions
    may be normal objects, shadows, or other image features.
    """
    if not image_bytes:
        raise ValueError("Empty image upload")

    arr = np.frombuffer(image_bytes, dtype=np.uint8)
    img = cv2.imdecode(arr, cv2.IMREAD_COLOR)

    if img is None:
        raise ValueError("Invalid or unsupported image")

    height, width = img.shape[:2]
    if height < 32 or width < 32:
        raise ValueError("Image must be at least 32x32 pixels")

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)

    # Normal binary threshold: bright regions become white.
    # This is suitable for the synthetic test image below.
    _, thresh = cv2.threshold(
        blurred, 50, 255, cv2.THRESH_BINARY
    )

    contours, _ = cv2.findContours(
        thresh,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE,
    )

    boxes = []

    for contour in contours:
        area = cv2.contourArea(contour)

        if area > MIN_CONTOUR_AREA:
            x, y, w, h = cv2.boundingRect(contour)
            boxes.append([int(x), int(y), int(w), int(h)])

    count = len(boxes)
    status = "REJECT" if count > 0 else "PASS"

    return {
        "status": status,
        # Thresholding does not produce calibrated confidence.
        "confidence": None,
        "defects_detected": count,
        "bounding_boxes": boxes,
        "message": (
            "Potential defect regions detected; manual review required."
            if count > 0
            else "No qualifying bright regions detected."
        ),
    }


@app.post("/inspect-item", response_model=InspectionResult)
async def inspect_item(file: UploadFile = File(...)):
    if file.content_type not in ALLOWED_TYPES:
        raise HTTPException(
            status_code=415,
            detail="Upload a JPEG, PNG, or WEBP image",
        )

    contents = await file.read(MAX_FILE_SIZE + 1)

    if not contents:
        raise HTTPException(
            status_code=400,
            detail="Empty upload",
        )

    if len(contents) > MAX_FILE_SIZE:
        raise HTTPException(
            status_code=413,
            detail="Image exceeds 10 MB limit",
        )

    try:
        return process_image_cv(contents)
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc))


@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "module": "Computer Vision QC Pipeline",
    }
